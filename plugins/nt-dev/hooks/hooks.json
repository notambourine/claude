{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gh-body-file-nowrap.mjs\"",
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash|Write|Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/gh-skill-nudge.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
