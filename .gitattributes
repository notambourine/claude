# Git for Windows defaults to core.autocrlf=true. Without these rules a Windows checkout
# rewrites every line ending, and `vendor-skills.mjs verify` reports the whole mirror as
# drifted because the manifest digests hash the bytes upstream published.

* text=auto eol=lf
*.woff2 binary

# Vendored trees round-trip verbatim: no normalization in either direction.
vendor/pristine/** -text
plugins/nt-vendor/skills/** -text
